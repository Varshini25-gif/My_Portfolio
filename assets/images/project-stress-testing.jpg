<svg width="600" height="400" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="400" fill="#0F172A"/>
  
  <!-- Header -->
  <rect width="600" height="60" fill="#1E293B"/>
  <text x="20" y="38" font-family="Arial" font-size="20" font-weight="bold" fill="#FDE68A">Stress Testing & Scenario Analysis</text>
  
  <!-- Scenario Cards -->
  <rect x="20" y="80" width="170" height="70" rx="8" fill="#1E293B"/>
  <text x="30" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Base Scenario</text>
  <text x="30" y="135" font-family="Arial" font-size="28" font-weight="bold" fill="#10B981">$2.1B</text>
  
  <rect x="210" y="80" width="170" height="70" rx="8" fill="#1E293B"/>
  <text x="220" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Moderate Stress</text>
  <text x="220" y="135" font-family="Arial" font-size="28" font-weight="bold" fill="#F59E0B">$1.7B</text>
  
  <rect x="400" y="80" width="180" height="70" rx="8" fill="#1E293B"/>
  <text x="410" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Severe Stress</text>
  <text x="410" y="135" font-family="Arial" font-size="28" font-weight="bold" fill="#EF4444">$1.2B</text>
  
  <!-- Historical Trends Chart -->
  <rect x="20" y="170" width="360" height="210" rx="8" fill="#1E293B"/>
  <text x="30" y="195" font-family="Arial" font-size="14" font-weight="bold" fill="#FDE68A">5-Year Historical Risk Metrics</text>
  
  <!-- Grid -->
  <line x1="45" y1="220" x2="45" y2="360" stroke="#334155" stroke-width="1"/>
  <line x1="45" y1="360" x2="360" y2="360" stroke="#334155" stroke-width="1"/>
  
  <!-- Y-axis labels -->
  <text x="25" y="230" font-family="Arial" font-size="9" fill="#94A3B8">$3B</text>
  <text x="25" y="270" font-family="Arial" font-size="9" fill="#94A3B8">$2B</text>
  <text x="25" y="310" font-family="Arial" font-size="9" fill="#94A3B8">$1B</text>
  <text x="30" y="350" font-family="Arial" font-size="9" fill="#94A3B8">$0</text>
  
  <!-- X-axis labels -->
  <text x="65" y="375" font-family="Arial" font-size="9" fill="#94A3B8">2020</text>
  <text x="125" y="375" font-family="Arial" font-size="9" fill="#94A3B8">2021</text>
  <text x="185" y="375" font-family="Arial" font-size="9" fill="#94A3B8">2022</text>
  <text x="245" y="375" font-family="Arial" font-size="9" fill="#94A3B8">2023</text>
  <text x="305" y="375" font-family="Arial" font-size="9" fill="#94A3B8">2024</text>
  
  <!-- Historical line -->
  <polyline points="70,320 130,300 190,310 250,290 310,280 340,270" 
            fill="none" stroke="#10B981" stroke-width="3" stroke-dasharray="5,5"/>
  
  <!-- Projected scenarios -->
  <polyline points="310,280 340,270 360,260" 
            fill="none" stroke="#10B981" stroke-width="3"/>
  <text x="350" y="255" font-family="Arial" font-size="8" fill="#10B981">Base</text>
  
  <polyline points="310,280 340,295 360,305" 
            fill="none" stroke="#F59E0B" stroke-width="3"/>
  <text x="350" y="320" font-family="Arial" font-size="8" fill="#F59E0B">Moderate</text>
  
  <polyline points="310,280 340,320 360,340" 
            fill="none" stroke="#EF4444" stroke-width="3"/>
  <text x="350" y="350" font-family="Arial" font-size="8" fill="#EF4444">Severe</text>
  
  <!-- Scenario Details -->
  <rect x="400" y="170" width="180" height="210" rx="8" fill="#1E293B"/>
  <text x="410" y="195" font-family="Arial" font-size="14" font-weight="bold" fill="#FDE68A">Scenario Impact</text>
  
  <!-- Impact metrics -->
  <rect x="410" y="210" width="160" height="45" rx="6" fill="#0F172A"/>
  <text x="420" y="228" font-family="Arial" font-size="11" fill="#94A3B8">GDP Shock</text>
  <text x="420" y="246" font-family="Arial" font-size="16" font-weight="bold" fill="#EF4444">-8.5%</text>
  
  <rect x="410" y="265" width="160" height="45" rx="6" fill="#0F172A"/>
  <text x="420" y="283" font-family="Arial" font-size="11" fill="#94A3B8">Unemployment</text>
  <text x="420" y="301" font-family="Arial" font-size="16" font-weight="bold" fill="#F59E0B">+12.3%</text>
  
  <rect x="410" y="320" width="160" height="50" rx="6" fill="#0F172A"/>
  <text x="420" y="338" font-family="Arial" font-size="11" fill="#94A3B8">Default Rate</text>
  <text x="420" y="356" font-family="Arial" font-size="16" font-weight="bold" fill="#EF4444">+6.8%</text>
</svg>
