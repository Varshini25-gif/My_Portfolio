<svg width="600" height="400" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="400" fill="#F3F4F6"/>
  
  <!-- Header -->
  <rect width="600" height="60" fill="#8B5CF6"/>
  <text x="20" y="38" font-family="Arial" font-size="20" font-weight="bold" fill="white">Customer Cohort Retention Analysis</text>
  
  <!-- Cohort Matrix -->
  <rect x="20" y="80" width="560" height="280" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <text x="30" y="105" font-family="Arial" font-size="14" font-weight="bold" fill="#1F2937">12-Month Retention Cohort</text>
  
  <!-- Headers -->
  <text x="30" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">Cohort</text>
  <text x="120" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M0</text>
  <text x="170" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M1</text>
  <text x="220" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M2</text>
  <text x="270" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M3</text>
  <text x="320" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M6</text>
  <text x="370" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M9</text>
  <text x="420" y="135" font-family="Arial" font-size="10" font-weight="bold" fill="#6B7280">M12</text>
  
  <!-- Cohort Data (Heatmap simulation) -->
  <!-- Jan 2024 -->
  <text x="30" y="165" font-family="Arial" font-size="10" fill="#6B7280">Jan '24</text>
  <rect x="110" y="150" width="40" height="25" fill="#10B981"/>
  <rect x="160" y="150" width="40" height="25" fill="#34D399"/>
  <rect x="210" y="150" width="40" height="25" fill="#6EE7B7"/>
  <rect x="260" y="150" width="40" height="25" fill="#A7F3D0"/>
  <rect x="310" y="150" width="40" height="25" fill="#D1FAE5"/>
  <rect x="360" y="150" width="40" height="25" fill="#ECFDF5"/>
  <rect x="410" y="150" width="40" height="25" fill="#F0FDF4"/>
  <text x="122" y="167" font-family="Arial" font-size="11" font-weight="bold" fill="white">100</text>
  <text x="175" y="167" font-family="Arial" font-size="11" font-weight="bold" fill="white">82</text>
  <text x="226" y="167" font-family="Arial" font-size="11" fill="#1F2937">75</text>
  <text x="276" y="167" font-family="Arial" font-size="11" fill="#1F2937">68</text>
  <text x="326" y="167" font-family="Arial" font-size="11" fill="#1F2937">61</text>
  <text x="376" y="167" font-family="Arial" font-size="11" fill="#1F2937">58</text>
  <text x="426" y="167" font-family="Arial" font-size="11" fill="#1F2937">55</text>
  
  <!-- Feb 2024 -->
  <text x="30" y="195" font-family="Arial" font-size="10" fill="#6B7280">Feb '24</text>
  <rect x="110" y="180" width="40" height="25" fill="#10B981"/>
  <rect x="160" y="180" width="40" height="25" fill="#34D399"/>
  <rect x="210" y="180" width="40" height="25" fill="#6EE7B7"/>
  <rect x="260" y="180" width="40" height="25" fill="#A7F3D0"/>
  <rect x="310" y="180" width="40" height="25" fill="#D1FAE5"/>
  <rect x="360" y="180" width="40" height="25" fill="#ECFDF5"/>
  <text x="122" y="197" font-family="Arial" font-size="11" font-weight="bold" fill="white">100</text>
  <text x="175" y="197" font-family="Arial" font-size="11" font-weight="bold" fill="white">85</text>
  <text x="226" y="197" font-family="Arial" font-size="11" fill="#1F2937">78</text>
  <text x="276" y="197" font-family="Arial" font-size="11" fill="#1F2937">72</text>
  <text x="326" y="197" font-family="Arial" font-size="11" fill="#1F2937">65</text>
  <text x="376" y="197" font-family="Arial" font-size="11" fill="#1F2937">62</text>
  
  <!-- Mar 2024 -->
  <text x="30" y="225" font-family="Arial" font-size="10" fill="#6B7280">Mar '24</text>
  <rect x="110" y="210" width="40" height="25" fill="#10B981"/>
  <rect x="160" y="210" width="40" height="25" fill="#34D399"/>
  <rect x="210" y="210" width="40" height="25" fill="#6EE7B7"/>
  <rect x="260" y="210" width="40" height="25" fill="#A7F3D0"/>
  <rect x="310" y="210" width="40" height="25" fill="#D1FAE5"/>
  <text x="122" y="227" font-family="Arial" font-size="11" font-weight="bold" fill="white">100</text>
  <text x="175" y="227" font-family="Arial" font-size="11" font-weight="bold" fill="white">88</text>
  <text x="226" y="227" font-family="Arial" font-size="11" fill="#1F2937">81</text>
  <text x="276" y="227" font-family="Arial" font-size="11" fill="#1F2937">75</text>
  <text x="326" y="227" font-family="Arial" font-size="11" fill="#1F2937">70</text>
  
  <!-- Apr 2024 -->
  <text x="30" y="255" font-family="Arial" font-size="10" fill="#6B7280">Apr '24</text>
  <rect x="110" y="240" width="40" height="25" fill="#10B981"/>
  <rect x="160" y="240" width="40" height="25" fill="#34D399"/>
  <rect x="210" y="240" width="40" height="25" fill="#6EE7B7"/>
  <rect x="260" y="240" width="40" height="25" fill="#A7F3D0"/>
  <text x="122" y="257" font-family="Arial" font-size="11" font-weight="bold" fill="white">100</text>
  <text x="175" y="257" font-family="Arial" font-size="11" font-weight="bold" fill="white">90</text>
  <text x="226" y="257" font-family="Arial" font-size="11" fill="#1F2937">84</text>
  <text x="276" y="257" font-family="Arial" font-size="11" fill="#1F2937">78</text>
  
  <!-- Legend -->
  <rect x="30" y="285" width="150" height="60" rx="6" fill="#F9FAFB"/>
  <text x="40" y="302" font-family="Arial" font-size="11" font-weight="bold" fill="#1F2937">Retention %</text>
  <rect x="40" y="310" width="15" height="15" fill="#10B981"/>
  <text x="60" y="322" font-family="Arial" font-size="9" fill="#6B7280">80-100%</text>
  <rect x="110" y="310" width="15" height="15" fill="#A7F3D0"/>
  <text x="130" y="322" font-family="Arial" font-size="9" fill="#6B7280">40-60%</text>
  
  <!-- Key Insights -->
  <rect x="200" y="285" width="370" height="60" rx="6" fill="#F9FAFB"/>
  <text x="210" y="302" font-family="Arial" font-size="11" font-weight="bold" fill="#1F2937">Key Insights</text>
  <text x="210" y="318" font-family="Arial" font-size="9" fill="#6B7280">• Avg 3-month retention: 78% (↑5% vs prev period)</text>
  <text x="210" y="333" font-family="Arial" font-size="9" fill="#6B7280">• Customer lifetime value increased by 25% after optimization</text>
</svg>
