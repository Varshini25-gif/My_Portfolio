<svg width="600" height="400" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="400" fill="#0F172A"/>
  
  <!-- Dashboard Header -->
  <rect width="600" height="60" fill="#1E293B"/>
  <text x="20" y="38" font-family="Arial" font-size="20" font-weight="bold" fill="#A5F3FC">Patient Care Dashboard</text>
  
  <!-- KPI Cards -->
  <rect x="20" y="80" width="170" height="100" rx="8" fill="#1E293B"/>
  <text x="30" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Readmission Rate</text>
  <text x="30" y="145" font-family="Arial" font-size="36" font-weight="bold" fill="#10B981">8.2%</text>
  <text x="30" y="170" font-family="Arial" font-size="10" fill="#10B981">▼ 1.5%</text>
  
  <rect x="210" y="80" width="170" height="100" rx="8" fill="#1E293B"/>
  <text x="220" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Avg Length of Stay</text>
  <text x="220" y="145" font-family="Arial" font-size="36" font-weight="bold" fill="#3B82F6">4.8</text>
  <text x="220" y="170" font-family="Arial" font-size="10" fill="#94A3B8">days</text>
  
  <rect x="400" y="80" width="180" height="100" rx="8" fill="#1E293B"/>
  <text x="410" y="105" font-family="Arial" font-size="12" fill="#94A3B8">Patient Satisfaction</text>
  <text x="410" y="145" font-family="Arial" font-size="36" font-weight="bold" fill="#A78BFA">92%</text>
  <text x="410" y="170" font-family="Arial" font-size="10" fill="#10B981">▲ 3.2%</text>
  
  <!-- Charts -->
  <rect x="20" y="200" width="360" height="180" rx="8" fill="#1E293B"/>
  <text x="30" y="225" font-family="Arial" font-size="14" font-weight="bold" fill="#A5F3FC">Patient Volume by Department</text>
  <!-- Horizontal bar chart -->
  <rect x="40" y="245" width="280" height="18" fill="#1E40AF" opacity="0.3"/>
  <rect x="40" y="245" width="220" height="18" fill="#3B82F6"/>
  <text x="265" y="258" font-family="Arial" font-size="11" fill="#E0E7FF">Emergency - 850</text>
  
  <rect x="40" y="275" width="280" height="18" fill="#1E40AF" opacity="0.3"/>
  <rect x="40" y="275" width="180" height="18" fill="#3B82F6"/>
  <text x="225" y="288" font-family="Arial" font-size="11" fill="#E0E7FF">Surgery - 620</text>
  
  <rect x="40" y="305" width="280" height="18" fill="#1E40AF" opacity="0.3"/>
  <rect x="40" y="305" width="150" height="18" fill="#3B82F6"/>
  <text x="195" y="318" font-family="Arial" font-size="11" fill="#E0E7FF">ICU - 480</text>
  
  <rect x="40" y="335" width="280" height="18" fill="#1E40AF" opacity="0.3"/>
  <rect x="40" y="335" width="120" height="18" fill="#3B82F6"/>
  <text x="165" y="348" font-family="Arial" font-size="11" fill="#E0E7FF">Pediatrics - 390</text>
  
  <!-- Donut Chart -->
  <rect x="400" y="200" width="180" height="180" rx="8" fill="#1E293B"/>
  <text x="410" y="225" font-family="Arial" font-size="14" font-weight="bold" fill="#A5F3FC">Care Efficiency</text>
  <circle cx="490" cy="300" r="50" fill="none" stroke="#334155" stroke-width="20"/>
  <circle cx="490" cy="300" r="50" fill="none" stroke="#10B981" stroke-width="20" stroke-dasharray="251.2 62.8" transform="rotate(-90 490 300)"/>
  <text x="475" y="305" font-family="Arial" font-size="24" font-weight="bold" fill="#10B981">80%</text>
</svg>
