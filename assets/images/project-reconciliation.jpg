<svg width="600" height="400" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="400" fill="#1F2937"/>
  
  <!-- Header -->
  <rect width="600" height="60" fill="#374151"/>
  <text x="20" y="38" font-family="Arial" font-size="20" font-weight="bold" fill="#E0E7FF">Financial Reconciliation System</text>
  
  <!-- Process Flow -->
  <rect x="30" y="90" width="120" height="80" rx="8" fill="#6366F1"/>
  <text x="50" y="125" font-family="Arial" font-size="12" font-weight="bold" fill="white">Source System</text>
  <text x="60" y="145" font-family="Arial" font-size="10" fill="#E0E7FF">Core Banking</text>
  <text x="65" y="160" font-family="Arial" font-size="10" fill="#E0E7FF">Database</text>
  
  <!-- Arrow -->
  <polygon points="160,130 190,130 190,125 200,135 190,145 190,140 160,140" fill="#10B981"/>
  
  <rect x="210" y="90" width="120" height="80" rx="8" fill="#8B5CF6"/>
  <text x="225" y="125" font-family="Arial" font-size="12" font-weight="bold" fill="white">Python Script</text>
  <text x="235" y="145" font-family="Arial" font-size="10" fill="#E0E7FF">Automated</text>
  <text x="235" y="160" font-family="Arial" font-size="10" fill="#E0E7FF">Validation</text>
  
  <!-- Arrow -->
  <polygon points="340,130 370,130 370,125 380,135 370,145 370,140 340,140" fill="#10B981"/>
  
  <rect x="390" y="90" width="120" height="80" rx="8" fill="#10B981"/>
  <text x="410" y="125" font-family="Arial" font-size="12" font-weight="bold" fill="white">Report</text>
  <text x="420" y="145" font-family="Arial" font-size="10" fill="#F0FDF4">Exceptions</text>
  <text x="425" y="160" font-family="Arial" font-size="10" fill="#F0FDF4">& Alerts</text>
  
  <!-- Statistics -->
  <rect x="30" y="200" width="250" height="170" rx="8" fill="#374151"/>
  <text x="45" y="230" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Daily Reconciliation Stats</text>
  
  <text x="45" y="260" font-family="Arial" font-size="12" fill="#94A3B8">Total Records Processed:</text>
  <text x="200" y="260" font-family="Arial" font-size="14" font-weight="bold" fill="#10B981">523,482</text>
  
  <text x="45" y="285" font-family="Arial" font-size="12" fill="#94A3B8">Matched Records:</text>
  <text x="200" y="285" font-family="Arial" font-size="14" font-weight="bold" fill="#10B981">522,987</text>
  
  <text x="45" y="310" font-family="Arial" font-size="12" fill="#94A3B8">Exceptions:</text>
  <text x="200" y="310" font-family="Arial" font-size="14" font-weight="bold" fill="#F59E0B">495</text>
  
  <text x="45" y="335" font-family="Arial" font-size="12" fill="#94A3B8">Success Rate:</text>
  <text x="200" y="335" font-family="Arial" font-size="14" font-weight="bold" fill="#10B981">99.91%</text>
  
  <rect x="45" y="345" width="220" height="10" fill="#1F2937" rx="5"/>
  <rect x="45" y="345" width="219" height="10" fill="#10B981" rx="5"/>
  
  <!-- Performance Metrics -->
  <rect x="300" y="200" width="280" height="170" rx="8" fill="#374151"/>
  <text x="315" y="230" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Performance Improvements</text>
  
  <!-- Bar Chart -->
  <text x="315" y="260" font-family="Arial" font-size="11" fill="#94A3B8">Processing Time</text>
  <rect x="315" y="270" width="250" height="25" fill="#1F2937" rx="4"/>
  <rect x="315" y="270" width="40" height="25" fill="#EF4444" rx="4"/>
  <text x="360" y="288" font-family="Arial" font-size="11" fill="#94A3B8">Before: 8.5 hrs</text>
  
  <rect x="315" y="305" width="250" height="25" fill="#1F2937" rx="4"/>
  <rect x="315" y="305" width="10" height="25" fill="#10B981" rx="4"/>
  <text x="330" y="323" font-family="Arial" font-size="11" fill="#10B981">After: 52 mins</text>
  
  <text x="315" y="350" font-family="Arial" font-size="12" font-weight="bold" fill="#10B981">Time Saved: 90%</text>
</svg>
