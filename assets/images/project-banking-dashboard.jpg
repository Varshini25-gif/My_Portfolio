<svg width="600" height="400" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="400" fill="#1E293B"/>
  
  <!-- Dashboard Header -->
  <rect width="600" height="60" fill="#334155"/>
  <text x="20" y="38" font-family="Arial" font-size="20" font-weight="bold" fill="#E0E7FF">Banking Risk Dashboard</text>
  <circle cx="560" cy="30" r="12" fill="#10B981"/>
  
  <!-- Main Content Area -->
  <rect x="20" y="80" width="270" height="140" rx="8" fill="#334155"/>
  <text x="30" y="105" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Capital Adequacy Ratio</text>
  <text x="30" y="160" font-family="Arial" font-size="48" font-weight="bold" fill="#10B981">14.2%</text>
  <text x="30" y="190" font-family="Arial" font-size="12" fill="#94A3B8">▲ 2.3% from last month</text>
  
  <rect x="310" y="80" width="270" height="140" rx="8" fill="#334155"/>
  <text x="320" y="105" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Total Exposure</text>
  <text x="320" y="160" font-family="Arial" font-size="36" font-weight="bold" fill="#6366F1">$2.4B</text>
  <text x="320" y="190" font-family="Arial" font-size="12" fill="#94A3B8">Credit + Market Risk</text>
  
  <!-- Charts -->
  <rect x="20" y="240" width="270" height="140" rx="8" fill="#334155"/>
  <text x="30" y="265" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Risk Trend (6 Months)</text>
  <!-- Line chart simulation -->
  <polyline points="40,350 80,330 120,340 160,310 200,320 240,300 280,295" fill="none" stroke="#10B981" stroke-width="3"/>
  <circle cx="40" cy="350" r="4" fill="#10B981"/>
  <circle cx="280" cy="295" r="4" fill="#10B981"/>
  
  <rect x="310" y="240" width="270" height="140" rx="8" fill="#334155"/>
  <text x="320" y="265" font-family="Arial" font-size="14" font-weight="bold" fill="#E0E7FF">Overdue Accounts</text>
  <!-- Bar chart simulation -->
  <rect x="330" y="320" width="40" height="40" fill="#EF4444"/>
  <rect x="385" y="300" width="40" height="60" fill="#F59E0B"/>
  <rect x="440" y="340" width="40" height="20" fill="#10B981"/>
  <rect x="495" y="330" width="40" height="30" fill="#10B981"/>
  <text x="340" y="375" font-family="Arial" font-size="10" fill="#94A3B8">Q1</text>
  <text x="395" y="375" font-family="Arial" font-size="10" fill="#94A3B8">Q2</text>
  <text x="450" y="375" font-family="Arial" font-size="10" fill="#94A3B8">Q3</text>
  <text x="505" y="375" font-family="Arial" font-size="10" fill="#94A3B8">Q4</text>
</svg>
